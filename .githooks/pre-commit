#!/bin/sh
# Generated by hugo-validator
# To regenerate: npx --no hugo-validator setup-hooks --force

# Runs the locally installed hugo-validator directly. It deliberately does not
# go through the npm package runner: without a local install, that would ask
# the npm registry for a package named hugo-validator, and this project is
# distributed from GitHub only. The registry name is not ours.
BIN="node_modules/.bin/hugo-validator"
if [ ! -x "$BIN" ]; then
  echo "hugo-validator is not installed in this project. Run: npm ci" >&2
  exit 1
fi

# --full: a commit is always gated by a complete run, never by cached results
"$BIN" validate --full
exit $?
