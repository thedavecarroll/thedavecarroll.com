# Cloudflare Pages response headers. https://developers.cloudflare.com/pages/configuration/headers/
# No "noai" directive here on purpose: this site allows AI search and agents and
# blocks only training crawlers, which is enforced at the Cloudflare edge.

# Content-Security-Policy is enforced (2026-10-10) after a report-only trial with no violations.
# A new external source (script, style, image, frame) must be added here or the browser blocks it.
/*
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://giscus.app https://gist.github.com; style-src 'self' 'unsafe-inline' https://github.githubassets.com https://giscus.app; img-src 'self' data: https://img.shields.io; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; media-src 'self'; frame-src https://giscus.app; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=(), interest-cohort=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 0

/.well-known/webfinger
  Content-Type: application/jrd+json

# Fingerprinted stylesheets: a style change gets a new URL, so the old one can be cached for good.
/scss/*
  Cache-Control: public, max-age=31536000, immutable
